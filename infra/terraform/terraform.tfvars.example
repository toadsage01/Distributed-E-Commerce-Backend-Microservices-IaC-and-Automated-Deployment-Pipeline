# Terraform variable values for the dev environment.
# Copy to terraform.tfvars and fill in your real values.

aws_region     = "us-east-1"
environment     = "dev"
project_name    = "ecom"
aws_account_id  = "REPLACE_WITH_YOUR_12_DIGIT_AWS_ACCOUNT_ID"

# VPC — defaults are fine for dev
vpc_cidr               = "10.0.0.0/16"
availability_zones      = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs    = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs   = ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]

# RDS — free-tier-eligible
rds_instance_class = "db.t3.micro"
rds_db_name        = "ecom"
rds_username       = "ecom_admin"
rds_password       = "REPLACE_WITH_A_STRONG_PASSWORD_AT_LEAST_16_CHARS"  # mark sensitive

# ElastiCache — free-tier-eligible
redis_node_type = "cache.t3.micro"

# EC2 — free-tier-eligible
ec2_instance_type = "t3.micro"
ec2_count         = 2
ec2_key_pair_name = "REPLACE_WITH_YOUR_EC2_KEY_PAIR_NAME"

# GitHub OIDC
github_org  = "toadsage01"
github_repo = "Distributed-E-Commerce-Backend-Microservices-IaC-and-Automated-Deployment-Pipeline"
