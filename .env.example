# Local development environment file.
# Copy to `.env` and override values as needed. DO NOT commit real secrets.
#
# The defaults below match docker-compose.yml — so if you just want to run
# `docker compose up --build`, you don't need this file at all.

# JWT secret — MUST be a long random string in prod.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-not-for-prod-please-override-with-a-long-random-string

# Database (matches docker-compose postgres service)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ecom

# Redis (matches docker-compose redis service)
REDIS_URL=redis://localhost:6379/0

# Environment
ENV=local
LOG_LEVEL=INFO

# Rate limiting (gateway only)
RATE_LIMIT_PER_MINUTE=100

# Service URLs (gateway + order-service use these to talk to each other)
USER_SERVICE_URL=http://user-service:8001
PRODUCT_SERVICE_URL=http://product-service:8002
ORDER_SERVICE_URL=http://order-service:8003

# Token TTLs
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
